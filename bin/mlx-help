#!/bin/bash
DIR="$HOME/llm-local"

cat <<'HELP'
Local MLX model commands
========================

  mlx-start gemma     Start Gemma (daily use, general tasks)
  mlx-start qwen      Start Qwen (advanced use, heavier)
  mlx-start paddle    Start PaddleOCR-VL (OCR: reads page text)
  mlx-status          Show which model is running
  mlx-stop            Stop the running server
  mlx-models          List downloaded models and their sizes
  mlx-ask             Send a prompt (and optionally an image) to the running model
  mlx-help            Show this help

Notes
-----
  * One server at a time, on port 8080. Starting a model stops the previous one.
  * Loading a model takes 20-60 seconds.
  * Server log: ~/llm-local/server.log

Examples
--------
  mlx-start gemma
  mlx-ask "Summarize the main idea of MST in 2 sentences"
  mlx-ask "Describe this image" photo.jpg

  # OCR a full page with PaddleOCR (needs long output and temperature 0)
  mlx-start paddle
  mlx-ask --max-tokens 4000 --temperature 0 "OCR:" page.png
  mlx-stop

mlx-ask options
---------------
  --max-tokens N      Maximum output length (default 800; use 4000 for full pages)
  --temperature T     Sampling temperature (use 0 for OCR)
HELP

echo
"$DIR/bin/mlx-status"
