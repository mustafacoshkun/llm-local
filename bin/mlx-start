#!/bin/bash
DIR="$HOME/llm-local"
PORT=8080
VENV="$DIR/.venv"
EXTRA_ARGS=""
case "$1" in
  qwen)   MODEL="mlx-community/Qwen3.8-27B-4bit" ;;
  gemma)  MODEL="mlx-community/gemma-4-26B-A4B-it-qat-4bit" ;;
  paddle) MODEL="OpenGryd/PaddleOCR-VL-1.6-MLX-16bit"
          VENV="$DIR/.venv-ocr"
          EXTRA_ARGS="--trust-remote-code" ;;
  *) echo "Usage: mlx-start qwen | gemma | paddle"; exit 1 ;;
esac

# Check the environment first, so a failed start doesn't kill the running server
if [ ! -x "$VENV/bin/python" ]; then
  echo "Environment not found: $VENV"; exit 1
fi

"$DIR/bin/mlx-stop" >/dev/null 2>&1   # stop any running server first

source "$VENV/bin/activate"
nohup python -m mlx_vlm.server --model "$MODEL" --port $PORT $EXTRA_ARGS > "$DIR/server.log" 2>&1 &
echo $! > "$DIR/server.pid"
echo "$MODEL" > "$DIR/current_model"

echo -n "Loading"
for i in $(seq 1 180); do
  if nc -z localhost $PORT 2>/dev/null; then
    echo; echo "Ready: $MODEL"; exit 0
  fi
  if ! kill -0 $(cat "$DIR/server.pid") 2>/dev/null; then
    echo; echo "Server exited. Log: tail -30 $DIR/server.log"; exit 1
  fi
  echo -n "."; sleep 1
done
echo; echo "Timed out. Log: $DIR/server.log"
